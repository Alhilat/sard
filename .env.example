# =============================================================================
# Sard Raqami Platform - Environment Configuration
# =============================================================================

# Server Ports
PORT=5000
VITE_PORT=5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sard_raqami

# Security (JWT Secrets must be at least 32 characters)
JWT_ACCESS_SECRET=sard_raqami_access_secret_key_minimum_32_characters_long!
JWT_REFRESH_SECRET=sard_raqami_refresh_secret_key_minimum_32_characters_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Logging
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# File Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email Delivery (console | resend | smtp)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@sardraqami.com
