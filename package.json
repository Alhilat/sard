{
  "name": "sard-raqami-monorepo",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/sard-raqami dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "dev:web": "pnpm --filter @workspace/sard-raqami dev",
    "start": "node ./apps/api/server.mjs",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --filter \"@workspace/*\" --if-present run typecheck",
    "db:generate": "pnpm --filter @workspace/api-server prisma generate",
    "backup:sync": "node ./scripts/sync-and-verify-backup.mjs",
    "backup:check": "node ./scripts/sync-and-verify-backup.mjs --verify-only",
    "backup:restore": "node ./scripts/restore-from-supabase.mjs",
    "backup:scheduler": "node ./scripts/backup-scheduler.mjs",
    "preinstall": "node -e \"const fs = require('fs'); ['package-lock.json','yarn.lock'].forEach(f => { try { fs.unlinkSync(f) } catch {} }); const agent = process.env.npm_config_user_agent || ''; if (!/^pnpm\\//.test(agent)) { console.error('Use pnpm instead'); process.exit(1); }\""
  },
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}
